rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Template header images uploaded from the mobile app. Twilio fetches them
    // through the tokenised download URL, so reads don't need auth rules.
    match /outreach_images/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }

    // Media attached in a chat. Uploaded by the app, then handed to Twilio by
    // the outreachApi function (Admin SDK). Create-only, typed and size-capped.
    match /outreach_media/{uid}/{leadId}/{messageId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if resource == null && request.auth != null && request.auth.uid == uid
                    && request.resource.size <= 16 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf');
      allow update, delete: if false;
    }
  }
}
