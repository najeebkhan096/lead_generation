rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Only mobile accounts the admin has flipped `approved` on can read
    // lead data. The flag is Admin-SDK-only after create — see users rules.
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // Admins (role 'admin', approved) run the admin console on the phone and
    // read and manage sales, salesmen and clients straight from Firestore.
    // The role is set only by an admin (see the users rules), so this cannot
    // be granted to oneself.
    function isAdmin() {
      return isApproved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Stored values for a sale's stages, as the backend and the admin console write them.
    function validSaleFields(d) {
      return (!('leadStatus' in d) || d.leadStatus in ['new', 'in_progress', 'payment', 'completed', 'cancelled'])
          && (!('clientPaymentStatus' in d) || d.clientPaymentStatus in ['pending', 'paid', 'stuck', 'received', 'in_process'])
          && (!('employeePaymentStatus' in d) || d.employeePaymentStatus in ['pending', 'paid']);
    }

    // The one client edit allowed on a verified lead (whatsappLeads /
    // emailLeads): mark it contacted, or move it back to New. Marking
    // contacted must carry its timestamp, and `contactedBy` can only name
    // the caller.
    function isContactedUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'contactedAt', 'contactedBy'])
          && d.status in ['lead', 'contacted']
          && (d.status == 'lead' || ('contactedAt' in d && d.contactedAt is timestamp))
          && (!('contactedBy' in d) || d.contactedBy == request.auth.uid);
    }

    // Mobile app can read leads and update tracking status.
    // Writes (creation/deletion) only via Admin SDK (backend).
    match /leads/{leadId} {
      allow read: if isApproved();
      // Restricted to the exact fields mobile's 4 update methods write
      // (mobile/lib/services/lead_repository.dart:60-105) — each one also
      // conditionally stamps `assignedTo` with the acting user's uid, and
      // updateWhatsAppStatus writes hasWhatsApp + whatsAppCheckedAt, so all
      // of these must stay listed or those calls get silently rejected.
      allow update: if isApproved()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'isFavorite', 'status', 'reputationStatus',
                         'hasWhatsApp', 'whatsAppCheckedAt',
                         'assignedTo', 'updatedAt'
                       ]);
      allow create, delete: if false;
    }

    match /searches/{searchId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // "Website leads" — businesses found during a scan with no website at
    // all, saved automatically alongside `leads`. Same read/update shape as
    // `leads` (mobile can favorite/status/assign but not create/delete).
    match /websiteLeads/{leadId} {
      allow read: if isApproved();
      allow update: if isApproved()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'isFavorite', 'status', 'reputationStatus',
                         'hasWhatsApp', 'whatsAppCheckedAt',
                         'assignedTo', 'updatedAt'
                       ]);
      allow create, delete: if false;
    }

    // Verified leads — the output of the two validators, written by the
    // backend (Admin SDK bypasses these rules). Signed-in, approved
    // salespeople can read them and do exactly one thing to them: mark one
    // contacted (or move it back to New) — `status`, `contactedAt`,
    // `contactedBy`, and nothing else, so a client can never alter the
    // verified contact details. `updatedAt` is deliberately not writable:
    // the lists are ordered by it.
    // Contacting a lead goes through the setWhatsAppLeadContacted function,
    // which enforces the salesman's daily limit. Clients cannot write here.
    match /whatsappLeads/{leadId} {
      allow read: if isApproved();
      allow update, create, delete: if false;
    }

    match /emailLeads/{leadId} {
      allow read: if isApproved();
      allow update: if isApproved() && isContactedUpdate();
      allow create, delete: if false;
    }

    // Mobile app users (salesmen) — each user creates/updates only their
    // own profile doc on sign-in; the web app's Admin SDK reads the full
    // list to populate "assign to salesman" pickers (Admin SDK bypasses
    // these rules entirely).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.approved == false
                    && !('dailyLeadLimit' in request.resource.data)
                    && (!('role' in request.resource.data) || request.resource.data.role == 'salesman');
      // Own-profile refresh on sign-in — cannot flip `approved`, its admin-set
      // `dailyLeadLimit`, or its `role`.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'dailyLeadLimit', 'role']);
      // An admin approves accounts, sets their daily limit and role, and nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['approved', 'dailyLeadLimit', 'role', 'updatedAt'])
                    && (!('approved' in request.resource.data) || request.resource.data.approved is bool)
                    && (!('role' in request.resource.data) || request.resource.data.role in ['admin', 'salesman'])
                    && (!('dailyLeadLimit' in request.resource.data)
                        || (request.resource.data.dailyLeadLimit is int
                            && request.resource.data.dailyLeadLimit >= 0
                            && request.resource.data.dailyLeadLimit <= 1000));
      allow delete: if false;
    }

    // App update rule (see mobile/lib/services/app_update.dart). Readable before
    // sign-in so an old install is stopped at once; only the console writes it.
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Excel-scan and WhatsApp-verified archive metadata (the actual .xlsx
    // lives in Storage, referenced by `downloadUrl` — a pre-signed URL,
    // fetchable without any Storage rule). Mobile reads these directly so
    // browsing/extracting businesses works without the backend server
    // (which only runs on the desktop Launcher's machine, unreachable from
    // a phone off that network). Writes stay Admin-SDK-only (the backend).
    match /excelScans/{id} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /whatsappValidatedScans/{id} {
      allow read: if isApproved();
      // Admins remove an archive (its record here, its .xlsx in Storage).
      allow delete: if isAdmin();
      allow create, update: if false;
    }

    // First salesman to tap WhatsApp on a verified business owns it.
    // Create-only so a second tap from someone else cannot steal the claim.
    match /whatsappClaims/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.claimedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Salesman orders/earnings (mobile's Sales tab) — each mobile user can
    // only read their own sales (salesmanId == their uid). Writes (status,
    // payment amounts) stay Admin-SDK-only, set from the web app.
    // Admins create, edit, delete and settle sales from the phone and the web.
    match /sales/{saleId} {
      allow read: if (isApproved() && resource.data.salesmanId == request.auth.uid) || isAdmin();
      allow create, update: if isAdmin() && validSaleFields(request.resource.data);
      allow delete: if isAdmin();
    }

    // Client businesses (name + Google Maps link), admin only.
    // Older clients may have no Maps link yet, so an update only checks the fields it sends.
    match /clients/{clientId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.businessName is string
                    && request.resource.data.mapsUrl is string;
      allow update: if isAdmin()
                    && (!('businessName' in request.resource.data) || request.resource.data.businessName is string)
                    && (!('mapsUrl' in request.resource.data) || request.resource.data.mapsUrl is string);
    }

    // Website-dev outreach is admin-backend only (Admin SDK). Mobile
    // never sends campaign mail; keep these collections client-denied.
    match /outreachRecords/{id} {
      allow read, write: if false;
    }
    match /outreachCampaigns/{id} {
      allow read, write: if false;
    }
    match /outreachQueue/{id} {
      allow read, write: if false;
    }
    match /outreachEvents/{id} {
      allow read, write: if false;
    }
    match /outreachUnsubscribes/{id} {
      allow read, write: if false;
    }
    match /outreachSettings/{id} {
      allow read, write: if false;
    }

    // WhatsApp (Twilio) outreach inbox. Cloud Functions (Admin SDK) create and
    // update leads, conversations and messages; the app only reads its own,
    // renames a lead / clears its unread badge, and hides a message locally.
    match /outreachLeads/{leadId} {
      allow read: if isApproved() && resource.data.ownerId == request.auth.uid;
      allow update: if isApproved()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'businessName', 'unreadCount'])
                    && request.resource.data.unreadCount == 0;
      allow create, delete: if false;
    }
    match /outreachConversations/{convId} {
      allow read: if isApproved() && resource.data.ownerId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isApproved()
                    && get(/databases/$(database)/documents/outreachConversations/$(convId)).data.ownerId == request.auth.uid;
        allow update: if isApproved()
                      && get(/databases/$(database)/documents/outreachConversations/$(convId)).data.ownerId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt']);
        allow create, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
