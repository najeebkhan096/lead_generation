PORT=3001

# Firebase (pick one auth method)
FIREBASE_PROJECT_ID=your-project-id

# Option A: path to service account JSON (recommended locally)
# Place the file at backend/firebase-service-account.json
# or set a custom path:
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccount.json

# Option B: paste the full service account JSON as a single line (good for Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Website-dev outreach (all optional except a from-address + one sender)
OUTREACH_FROM_EMAIL=you@yourdomain.com
OUTREACH_SENDER_NAME=Najeeb
OUTREACH_REPLY_TO=
OUTREACH_TEST_EMAIL=you@yourdomain.com
OUTREACH_PUBLIC_BASE_URL=http://localhost:3001
OUTREACH_SEND_INTERVAL_MS=8000

# AI email generation — leave unset to use the built-in template
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Email sending — pick one
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional HTTP email verifier (otherwise MX/syntax only)
# EMAIL_VERIFICATION_URL=
# EMAIL_VERIFICATION_API_KEY=
